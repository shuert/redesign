---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  eyebrowVariant?: 'plain' | 'pill';
  title: string;
  cta: string;
  /** Desktop title width as a percentage of the card. Omit to keep the title on one line. */
  titleWidth?: number;
}

const {
  href,
  image,
  imageAlt,
  eyebrow,
  eyebrowVariant = 'plain',
  title,
  cta,
  titleWidth,
} = Astro.props;

const imageOpt = await getImage({ src: image, width: 1800, format: 'webp', quality: 80 });
---

<div class:list={['explore-card', eyebrowVariant === 'pill' && 'explore-card--pill-eyebrow']}>
  <img
    class="explore-card__img"
    src={imageOpt.src}
    alt={imageAlt}
    width={imageOpt.attributes.width}
    height={imageOpt.attributes.height}
    loading="lazy"
    decoding="async"
  />
  <div class="explore-card__scrim" aria-hidden="true"></div>
  <span class:list={['explore-card__eyebrow', eyebrowVariant === 'pill' && 'explore-card__eyebrow--pill']}>
    {eyebrow}
  </span>
  <div class="explore-card__content">
    <p class="explore-card__title" style={titleWidth ? `--title-w: ${titleWidth}cqw` : undefined}>{title}</p>
    <a href={href} class="button button-primary explore-card__cta">{cta}</a>
  </div>
</div>

<style>
  .explore-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(17.5rem, 42vw, 31.25rem);
    border-radius: var(--r-img);
    overflow: hidden;
    color: inherit;
    cursor: default;
    container-type: inline-size;
  }

  .explore-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .explore-card__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 20%,
      rgba(0, 0, 0, 0.35) 55%,
      rgba(0, 0, 0, 0.82) 100%
    );
  }

  /* Figma 2003:8146 / 2003:8151 — 29px inset from card top-left */
  .explore-card__eyebrow {
    position: absolute;
    z-index: 1;
    top: 1.8125rem;
    left: 1.8125rem;
    font: var(--w-medium) 1rem / normal var(--ff-r);
    color: var(--c-white);
  }

  .explore-card__eyebrow--pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 1.125rem;
    border-radius: 1.5625rem;
    background: var(--c-black);
  }

  .explore-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 1.5rem 1.75rem;
  }

  @media (min-width: 48.0625rem) {
    .explore-card__content {
      padding: 1.75rem 2rem 2rem;
    }
  }

  .explore-card--pill-eyebrow .explore-card__content {
    gap: 1rem;
  }

  .explore-card__title {
    margin: 0;
    font: var(--w-light) var(--h5) / 1.28 var(--ff-r);
    color: var(--c-white);
  }

  @media (min-width: 48.0625rem) {
    .explore-card__title {
      width: var(--title-w, max-content);
      max-width: 100%;
    }
  }

  .explore-card__cta {
    margin-top: 0.25rem;
    text-decoration: none;
  }

</style>
