---
import { getImage } from 'astro:assets';
import Mainlayout from './Mainlayout.astro';
import LeadForm from '../components/LeadForm.astro';
import type { ProductPageData } from '../data/products/types';

import regMark from '../assets/product/shared/reg-mark.svg?url';
import arrowLeft from '../assets/product/shared/arrow-left.svg?url';
import arrowRight from '../assets/product/shared/arrow-right.svg?url';
import downloadIcon from '../assets/product/shared/download.svg?url';
import rowDownloadIcon from '../assets/product/shared/row-download.svg?url';
import playIcon from '../assets/product/shared/play-icon.svg?url';
import articleArrow from '../assets/sustainability/d58370a5254402baa86cccccda6ec1a84a25ab0a.svg?url';

interface Props {
  product: ProductPageData;
}

const { product } = Astro.props;

const {
  title,
  name,
  nameLines,
  showRegMark = true,
  featuresEyebrow = 'PRODUCT',
  attributesEyebrow = 'PRODUCT',
  attributesTitle = 'Attributes',
  optionsEyebrow = 'OPTIONS',
  crumbLabel,
  headerDims,
  headerBg,
  aboutEyebrow,
  aboutText,
  thumbnails,
  accordionItems,
  attributes: features,
  optionCols,
  systemDataRows,
  systemData,
  stories,
  related,
  quoteTitle,
  quoteImage,
  video,
  technicalSheetHref = '#',
  requestQuoteHref = '#request-a-quote',
} = product;

const FEATURES_AUTOPLAY_MS = product.attributesAutoplayMs ?? 6000;
const hasSystemData = Boolean(systemData?.rows?.length || systemDataRows?.length);
const systemDownloads = systemData?.showDownloads !== false;

/** Display widths (~2x retina) — masters stay in assets; only derivatives ship to the browser */
const headerBgOpt = await getImage({ src: headerBg, width: 2400, format: 'webp', quality: 80 });

const gallery = await Promise.all(
  thumbnails.map(async (t) => ({
    alt: t.alt,
    full: await getImage({ src: t.img, width: 1400, format: 'webp', quality: 80 }),
    thumb: await getImage({ src: t.img, width: 240, format: 'webp', quality: 75 }),
  })),
);
const featuresOpt = await Promise.all(
  features.map(async (f) => ({
    tag: f.tag,
    desc: f.desc,
    img: await getImage({ src: f.img, width: 1600, format: 'webp', quality: 80 }),
  })),
);
const firstFeature = featuresOpt[0];
const lastFeature = featuresOpt[featuresOpt.length - 1];

const relatedOpt = await Promise.all(
  related.map(async (r) => ({
    ...r,
    img: await getImage({ src: r.img, width: 1100, format: 'webp', quality: 80 }),
  })),
);

const videoPosterOpt = video
  ? await getImage({ src: video.poster, width: 1920, format: 'webp', quality: 80 })
  : null;

const storiesOpt = stories
  ? {
      eyebrow: stories.eyebrow,
      title: stories.title,
      articles: await Promise.all(
        stories.articles.map(async (article) => ({
          source: article.source,
          body: article.body,
          href: article.href,
          crop: article.crop,
          img: await getImage({
            src: article.img,
            width: article.crop ? 1400 : 1100,
            format: 'webp',
            quality: 80,
          }),
        })),
      ),
    }
  : null;

function cellText(cell: string | { imperial: string; metric: string }): string {
  return typeof cell === 'string' ? cell : cell.imperial;
}

function cellIsPair(cell: string | { imperial: string; metric: string }): cell is { imperial: string; metric: string } {
  return typeof cell !== 'string';
}
---

<Mainlayout title={title} mainClass="bp">
  <!-- ============================== HERO HEADER ============================== -->
  <section class="bp-header">
    <div class="bp-header__bg" aria-hidden="true">
      <img
        src={headerBgOpt.src}
        alt=""
        width={headerBgOpt.attributes.width}
        height={headerBgOpt.attributes.height}
        class="bp-header__img"
        loading="eager"
        decoding="async"
      />
      <div class="bp-header__gradient"></div>
    </div>
    <div class="container bp-header__inner">
      <p class="bp-header__crumb">
        <a href="/" class="bp-header__crumb-dim">HOME</a><span class="bp-header__crumb-dim" aria-hidden="true">&ensp;/&ensp;</span><a href="/products" class="bp-header__crumb-dim">ALL PRODUCTS</a><span class="bp-header__crumb-dim" aria-hidden="true">&ensp;/&ensp;</span>{crumbLabel}
      </p>
      <h1 class="bp-header__title detail-xl text-white">
        {
          nameLines?.length ? (
            <span>
              {nameLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </span>
          ) : (
            name
          )
        }
        {showRegMark && <img src={regMark} alt="" class="bp-header__reg" width="18" height="23" />}
      </h1>

      {
        headerDims && (
          <div class="bp-header__meta">
            <span
              class="bp-header__dims"
              data-unit-value
              data-imperial={headerDims.imperial}
              data-metric={headerDims.metric}>{headerDims.imperial}</span
            >
            <div class="bp-toggle" role="group" aria-label="Unit system" data-unit-toggle>
              <button type="button" class="bp-toggle__btn is-active" data-unit="imperial" aria-pressed="true">Imperial</button>
              <button type="button" class="bp-toggle__btn" data-unit="metric" aria-pressed="false">Metric</button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ============================== OVERVIEW ============================== -->
  <section class="bp-overview">
    <div class="bp-overview__media">
      {gallery.map((t, i) => (
        <img
          src={t.full.src}
          alt={t.alt}
          width={t.full.attributes.width}
          height={t.full.attributes.height}
          class:list={['bp-gallery__full', { 'is-active': i === 0 }]}
          loading="eager"
          decoding="async"
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))}
    </div>

    <button type="button" class="bp-gallery__nav bp-gallery__nav--prev" aria-label="Previous image">
      <img src={arrowLeft} alt="" width="50" height="50" />
    </button>
    <button type="button" class="bp-gallery__nav bp-gallery__nav--next" aria-label="Next image">
      <img src={arrowRight} alt="" width="50" height="50" />
    </button>

    <div class="bp-gallery__thumbs" role="tablist" aria-label="Product views">
      {gallery.map((t, i) => (
        <button type="button" class:list={['bp-gallery__thumb', { 'is-active': i === 0 }]} aria-label={t.alt}>
          <img src={t.thumb.src} alt="" width={t.thumb.attributes.width} height={t.thumb.attributes.height} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>

    <div class="bp-about">
      <p class="bp-eyebrow bp-about__eyebrow">{aboutEyebrow}</p>
      <p class="bp-about__desc">{aboutText}</p>
    </div>

    <div class="bp-overview__actions">
      <a href={requestQuoteHref} class="bp-btn bp-btn--dark bp-overview__cta">Request a Quote</a>
      <a href={technicalSheetHref} class="bp-btn bp-btn--outline bp-overview__download">
        Download Technical Sheet
        <img src={downloadIcon} alt="" width="14" height="15" class="bp-btn__icon" />
      </a>
    </div>
  </section>

  <!-- ============================== PRODUCT FEATURES (ACCORDION) ============================== -->
  <section class="bp-product-features">
    <div class="container">
      <div class="page-grid bp-product-features__grid">
        <header class="bp-product-features__heading">
          <p class="bp-eyebrow bp-eyebrow--dim">{featuresEyebrow}</p>
          <h2 class="bp-section__title">Features</h2>
        </header>

        <div class="bp-accordion" data-bp-accordion>
          {
            accordionItems.map((item, i) => (
              <div class="bp-accordion__item">
                <button
                  type="button"
                  class="bp-accordion__trigger"
                  aria-expanded="false"
                  aria-controls={`bp-accordion-panel-${i}`}
                  id={`bp-accordion-trigger-${i}`}
                  data-accordion-trigger
                >
                  <span class="bp-accordion__title">{item.title}</span>
                  <span class="bp-accordion__icon" aria-hidden="true" />
                </button>
                <div
                  class="bp-accordion__panel"
                  id={`bp-accordion-panel-${i}`}
                  role="region"
                  aria-labelledby={`bp-accordion-trigger-${i}`}
                  data-accordion-panel
                >
                  <div class="bp-accordion__panel-inner">
                    {'body' in item ? (
                      <p class="bp-accordion__body">{item.body}</p>
                    ) : (
                      <p class="bp-accordion__body">
                        {item.bodyBefore}
                        <span data-unit-value data-imperial={item.densityImperial} data-metric={item.densityMetric}
                          >{item.densityImperial}</span
                        >
                        {item.bodyAfter}
                      </p>
                    )}
                  </div>
                </div>
                {i < accordionItems.length - 1 && <div class="bp-accordion__rule" aria-hidden="true" />}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== ATTRIBUTES (SWIPER) ============================== -->
  <section
    class="bp-features"
    id="bp-features-carousel"
    role="region"
    aria-roledescription="carousel"
    aria-label="Product attributes"
    style={`--bp-autoplay-ms: ${FEATURES_AUTOPLAY_MS}ms`}
  >
    <div class="container">
      <header class="bp-section__head bp-section__head--attributes">
        <p class="bp-eyebrow bp-eyebrow--dim">{attributesEyebrow}</p>
        <h2 class="bp-section__title">{attributesTitle}</h2>
      </header>
    </div>

    <div class="bp-swiper__viewport" id="bp-features-rail" aria-live="polite">
      <div class="bp-swiper__track" data-carousel-swiper-track>
        <!-- Clone of last slide (peeks on the left of slide 0) -->
        <article class="bp-swiper__slide bp-feat" aria-hidden="true" data-carousel-clone>
          <img src={lastFeature.img.src} alt="" width={lastFeature.img.attributes.width} height={lastFeature.img.attributes.height} loading="eager" decoding="async" />
          <div class="bp-feat__gradient" aria-hidden="true"></div>
          <span class="bp-feat__tag">{lastFeature.tag}</span>
          <p class="bp-feat__desc">{lastFeature.desc}</p>
        </article>
        {
          featuresOpt.map((f, si) => (
            <article
              class:list={['bp-swiper__slide', 'bp-feat', { 'is-active': si === 0 }]}
              data-carousel-swiper-slide
              data-carousel-slide-index={si}
              aria-hidden={si !== 0}
            >
              <img src={f.img.src} alt={si === 0 ? f.tag : ''} width={f.img.attributes.width} height={f.img.attributes.height} loading="eager" decoding="async" />
              <div class="bp-feat__gradient" aria-hidden="true" />
              <span class="bp-feat__tag">{f.tag}</span>
              <p class="bp-feat__desc">{f.desc}</p>
            </article>
          ))
        }
        <!-- Clone of first slide (peeks on the right of last slide) -->
        <article class="bp-swiper__slide bp-feat" aria-hidden="true" data-carousel-clone>
          <img src={firstFeature.img.src} alt="" width={firstFeature.img.attributes.width} height={firstFeature.img.attributes.height} loading="eager" decoding="async" />
          <div class="bp-feat__gradient" aria-hidden="true"></div>
          <span class="bp-feat__tag">{firstFeature.tag}</span>
          <p class="bp-feat__desc">{firstFeature.desc}</p>
        </article>
      </div>
    </div>

    <div class="container bp-swiper__controls">
      <div class="bp-swiper__controls-inner">
        <div class="bp-swiper__arrows">
          <button type="button" class="bp-swiper__arrow" aria-label="Previous slide" data-carousel-prev>
            <svg class="bp-swiper__arrow-svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M14 7l-5 5 5 5"></path>
            </svg>
          </button>
          <button type="button" class="bp-swiper__arrow" aria-label="Next slide" data-carousel-next>
            <svg class="bp-swiper__arrow-svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M10 7l5 5-5 5"></path>
            </svg>
          </button>
        </div>
        <div class="bp-swiper__dots-wrap">
          <div class="bp-swiper__dots" role="presentation" data-carousel-dots>
            <div class="bp-swiper__dots-track" data-carousel-dots-track>
              <div class="bp-swiper__dots-row">
                {
                  features.map((_, i) => (
                    <div class="bp-swiper__dot-slot" data-carousel-slot={i}>
                      <div class:list={['bp-swiper__dot-grow', { 'is-active': i === 0 }]}>
                        <span class="bp-swiper__dot-grow-fill" data-carousel-grow-fill />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== OPTIONS ============================== -->
  <section
    class:list={[
      'bp-options',
      { 'bp-options--has-video': Boolean(video) },
      { 'bp-options--to-related': !hasSystemData && !video },
    ]}
  >
    <div class="container">
      <header class="bp-section__head bp-section__head--options">
        <p class="bp-eyebrow bp-eyebrow--dim">{optionsEyebrow}</p>
        <h2 class="bp-section__title">Flexible to Fit Your Needs</h2>
      </header>
      <div class="bp-options__grid">
        {
          optionCols.map((col) => (
            <ul class="bp-options__list">
              {col.map((label) => (
                <li class="bp-options__item">{label}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <slot name="after-options" />

  <!-- ============================== VIDEO (optional, after Options) ============================== -->
  {
    video && (
      <section
        class:list={['bp-video', { 'bp-video--to-related': !hasSystemData }]}
        aria-label={video.label ?? 'Product video'}
      >
        <div class="container">
          <div class="bp-video__media">
            <video
              class="bp-video__el"
              data-bp-video
              poster={videoPosterOpt!.src}
              preload="metadata"
              playsinline
              controls={false}
            >
              {video.src && <source src={video.src} type="video/mp4" />}
            </video>
            <button type="button" class="bp-video__play" data-bp-video-play aria-label="Play video">
              <img src={playIcon} alt="" width="80" height="80" />
            </button>
          </div>
        </div>
      </section>
    )
  }

  {
    systemData && systemData.rows.length > 0 && (
      <section class="bp-system" id="system-data">
        <div class="container">
          <header class="bp-section__head bp-section__head--system">
            <p class="bp-eyebrow bp-eyebrow--dim">PRODUCT</p>
            <h2 class="bp-section__title">System Data</h2>
          </header>

          <div
            class:list={['bp-system__table', 'bp-system__table--flex', { 'bp-system__table--plain': !systemDownloads }]}
            role="table"
            aria-label={`${title} system data`}
            style={`--bp-system-cols: ${systemData.columns.length}`}
          >
            <div class="bp-system__head" role="row">
              {systemDownloads && <div class="bp-system__dl-col" aria-hidden="true"></div>}
              {systemData.columns.map((col) => (
                <div class="bp-system__cell bp-system__cell--label" role="columnheader">
                  {col}
                </div>
              ))}
            </div>
            {systemData.rows.map((row) => {
              const label = row.downloadLabel ?? cellText(row.cells[0] ?? '');
              return (
                <div class:list={['bp-system__row', { 'is-highlight': row.highlight }]} role="row">
                  {systemDownloads && (
                    <div class="bp-system__dl-col">
                      <a class="bp-system__dl" href="#" aria-label={`Download data sheet for ${label}`}>
                        <img src={rowDownloadIcon} alt="" width="22" height="22" />
                      </a>
                    </div>
                  )}
                  {row.cells.map((cell) =>
                    cellIsPair(cell) ? (
                      <div
                        class="bp-system__cell"
                        role="cell"
                        data-unit-value
                        data-imperial={cell.imperial}
                        data-metric={cell.metric}
                      >
                        {cell.imperial}
                      </div>
                    ) : (
                      <div class="bp-system__cell" role="cell">
                        {cell}
                      </div>
                    ),
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    !systemData && systemDataRows && systemDataRows.length > 0 && (
      <section class="bp-system" id="system-data">
        <div class="container">
          <header class="bp-section__head bp-section__head--system">
            <p class="bp-eyebrow bp-eyebrow--dim">PRODUCT</p>
            <h2 class="bp-section__title">System Data</h2>
          </header>

          <div class="bp-system__table" role="table" aria-label={`${title} system data`}>
            <div class="bp-system__head" role="row">
              <div class="bp-system__dl-col" aria-hidden="true"></div>
              <div class="bp-system__cell bp-system__cell--label" role="columnheader">Outside Dimensions</div>
              <div class="bp-system__cell bp-system__cell--label" role="columnheader">Inside Dimensions</div>
              <div class="bp-system__cell bp-system__cell--label" role="columnheader">Cover Weight</div>
              <div class="bp-system__cell bp-system__cell--label" role="columnheader">Pallet Weight</div>
            </div>
            {
              systemDataRows.map((row) => (
                <div class:list={['bp-system__row', { 'is-highlight': row.highlight }]} role="row">
                  <div class="bp-system__dl-col">
                    <a
                      class="bp-system__dl"
                      href="#"
                      data-unit-aria
                      data-imperial={`Download data sheet for ${row.outside.imperial}`}
                      data-metric={`Download data sheet for ${row.outside.metric}`}
                      aria-label={`Download data sheet for ${row.outside.imperial}`}
                    >
                      <img src={rowDownloadIcon} alt="" width="22" height="22" />
                    </a>
                  </div>
                  <div
                    class="bp-system__cell"
                    role="cell"
                    data-unit-value
                    data-imperial={row.outside.imperial}
                    data-metric={row.outside.metric}
                  >
                    {row.outside.imperial}
                  </div>
                  <div
                    class="bp-system__cell"
                    role="cell"
                    data-unit-value
                    data-imperial={row.inside.imperial}
                    data-metric={row.inside.metric}
                  >
                    {row.inside.imperial}
                  </div>
                  <div
                    class="bp-system__cell"
                    role="cell"
                    data-unit-value
                    data-imperial={row.cover.imperial}
                    data-metric={row.cover.metric}
                  >
                    {row.cover.imperial}
                  </div>
                  <div
                    class="bp-system__cell"
                    role="cell"
                    data-unit-value
                    data-imperial={row.pallet.imperial}
                    data-metric={row.pallet.metric}
                  >
                    {row.pallet.imperial}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  {
    storiesOpt && (
      <section class="bp-stories" aria-label={storiesOpt.title}>
        <div class="container">
          <header class="bp-stories__head">
            <p class="bp-eyebrow bp-eyebrow--dim">{storiesOpt.eyebrow}</p>
            <h2 class="bp-section__title">{storiesOpt.title}</h2>
          </header>
          <div class="bp-stories__grid">
            {storiesOpt.articles.map((article) => (
              <article class="bp-story">
                <div class="bp-story__media">
                  <img
                    src={article.img.src}
                    alt=""
                    width={article.img.attributes.width}
                    height={article.img.attributes.height}
                    loading="lazy"
                    decoding="async"
                    class:list={{ 'is-cropped': Boolean(article.crop) }}
                    style={
                      article.crop
                        ? `width:${article.crop.width};height:${article.crop.height};left:${article.crop.left};top:${article.crop.top}`
                        : undefined
                    }
                  />
                  <span class="bp-story__badge">{article.source}</span>
                </div>
                <p class="bp-story__body">{article.body}</p>
                <a class="bp-story__link" href={article.href}>
                  <span>Read full article</span>
                  <img src={articleArrow} alt="" width="12" height="8" />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============================== OTHER SIMILAR PRODUCTS ============================== -->
  <section class="bp-related">
    <div class="container">
      <header class="bp-section__head bp-section__head--related">
        <p class="bp-eyebrow bp-eyebrow--dim">RELATED</p>
        <h2 class="bp-section__title">Other Similar Products</h2>
      </header>
      <div class="bp-related__grid">
        {relatedOpt.map((r) => (
          <a class="bp-related__card" href={r.href}>
            <div class="bp-related__media">
              <img
                src={r.img.src}
                alt={r.name}
                width={r.img.attributes.width}
                height={r.img.attributes.height}
                loading="lazy"
                decoding="async"
                style={
                  r.crop
                    ? `width:${r.crop.width};height:${r.crop.height};left:${r.crop.left};top:${r.crop.top}`
                    : undefined
                }
              />
            </div>
            <div class="bp-related__text">
              <h3 class="bp-related__name">{r.name}</h3>
              <p
                class="bp-related__size"
                data-unit-value
                data-imperial={r.size.imperial}
                data-metric={r.size.metric}
              >
                {r.size.imperial}
              </p>
            </div>
          </a>
        ))}
      </div>
      <div class="bp-related__cta">
        <a href="/products" class="bp-btn bp-btn--dark">See All Products</a>
      </div>
    </div>
  </section>

  <LeadForm
    variant="quote"
    image={quoteImage}
    imageAlt="Forklift moving stacked reusable pallets in a warehouse"
    title={quoteTitle}
    imageRatio="789 / 937"
    imageCrop={{ width: '283.9%', height: 'auto', left: '-87.9%', top: '-34.47%' }}
    imageFirstOnNarrow
  />

</Mainlayout>

<script>
  // ---- Product gallery thumbnail switching ----
  const frames = Array.from(document.querySelectorAll<HTMLImageElement>('.bp-gallery__full'));
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.bp-gallery__thumb'));
  let galleryIndex = 0;

  function selectThumb(i: number) {
    if (!thumbs.length || !frames.length) return;
    galleryIndex = (i + thumbs.length) % thumbs.length;
    frames.forEach((img, idx) => {
      const active = idx === galleryIndex;
      img.classList.toggle('is-active', active);
      img.toggleAttribute('aria-hidden', !active);
    });
    thumbs.forEach((t, idx) => t.classList.toggle('is-active', idx === galleryIndex));
  }

  thumbs.forEach((t, i) => t.addEventListener('click', () => selectThumb(i)));
  document.querySelector('.bp-gallery__nav--prev')?.addEventListener('click', () => selectThumb(galleryIndex - 1));
  document.querySelector('.bp-gallery__nav--next')?.addEventListener('click', () => selectThumb(galleryIndex + 1));


  // ---- Optional product video ----
  (function () {
    const video = document.querySelector<HTMLVideoElement>('[data-bp-video]');
    const playBtn = document.querySelector<HTMLButtonElement>('[data-bp-video-play]');
    if (!video || !playBtn) return;

    function setPlaying(playing: boolean) {
      playBtn.hidden = playing;
      playBtn.setAttribute('aria-hidden', playing ? 'true' : 'false');
      video.controls = playing;
    }

    playBtn.addEventListener('click', () => {
      video.play().then(() => setPlaying(true)).catch(() => {});
    });

    video.addEventListener('pause', () => {
      if (!video.ended) setPlaying(false);
    });
    video.addEventListener('ended', () => setPlaying(false));
  })();

  // ---- Imperial / Metric unit toggle ----
  (function () {
    const toggle = document.querySelector('[data-unit-toggle]');
    if (!toggle) return;

    const btns = Array.from(toggle.querySelectorAll<HTMLButtonElement>('.bp-toggle__btn'));

    function applyUnit(unit: 'imperial' | 'metric') {
      document.querySelectorAll<HTMLElement>('[data-unit-value]').forEach((el) => {
        const next = el.getAttribute(`data-${unit}`);
        if (next != null) el.textContent = next;
      });

      document.querySelectorAll<HTMLElement>('[data-unit-aria]').forEach((el) => {
        const next = el.getAttribute(`data-${unit}`);
        if (next != null) el.setAttribute('aria-label', next);
      });

      btns.forEach((btn) => {
        const active = btn.dataset.unit === unit;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      document.documentElement.dataset.units = unit;
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const unit = btn.dataset.unit;
        if (unit === 'imperial' || unit === 'metric') applyUnit(unit);
      });
    });
  })();

  // ---- Product features accordion — one panel open at a time; click open item to close ----
  (function () {
    const root = document.querySelector('[data-bp-accordion]');
    if (!root) return;

    const items = Array.from(root.querySelectorAll('.bp-accordion__item'));

    function setOpen(target: Element | null) {
      items.forEach((item) => {
        const trigger = item.querySelector('[data-accordion-trigger]');
        const open = target !== null && item === target;
        item.classList.toggle('is-open', open);
        if (trigger instanceof HTMLButtonElement) {
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
      });
    }

    items.forEach((item) => {
      const trigger = item.querySelector('[data-accordion-trigger]');
      trigger?.addEventListener('click', () => {
        if (item.classList.contains('is-open')) {
          setOpen(null);
          return;
        }
        setOpen(item);
      });
    });
  })();

</script>

<script
  define:vars={{
    bpAutoplayMs: FEATURES_AUTOPLAY_MS,
  }}
>
  /* Technical features swiper — same implementation as the careers culture carousel */
  (function () {
    const root = document.getElementById('bp-features-carousel');
    if (!root) return;

    const ANIM_NAME = 'bp-dot-progress';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.style.setProperty('--bp-autoplay-ms', `${bpAutoplayMs}ms`);

    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const slotEls = root.querySelectorAll('[data-carousel-slot]');
    const realSlideEls = root.querySelectorAll('[data-carousel-swiper-slide]');
    const allSlideEls = root.querySelectorAll('.bp-swiper__slide');
    const viewport = root.querySelector('#bp-features-rail');
    const track = root.querySelector('[data-carousel-swiper-track]');

    const n = realSlideEls.length;
    let realIndex = 0;
    let domIndex = 1;
    let prevDotsIndex = -1;
    let shapeTimer = 0;
    let sliding = false;
    let ready = false;
    let hoverPaused = false;
    let holdPaused = false;
    let tapPaused = false;
    let lastTouchAt = 0;
    const SHAPE_SETTLE_MS = 480;
    var TRACK_EASE = 'transform 0.55s cubic-bezier(0.32, 0.72, 0, 1)';
    var OPACITY_EASE = 'opacity 0.45s ease';

    function getSlideMetrics() {
      var firstEl = allSlideEls[0];
      if (!firstEl || !viewport) return { slideW: 0, gap: 20, vpW: 0 };
      var vpW = viewport.getBoundingClientRect().width;
      var slideW = firstEl.getBoundingClientRect().width;
      var gap = parseFloat(getComputedStyle(track).gap) || 20;
      return { slideW: slideW, gap: gap, vpW: vpW };
    }

    function calcTranslateX(di) {
      var m = getSlideMetrics();
      var center = (m.vpW - m.slideW) / 2;
      return center - di * (m.slideW + m.gap);
    }

    function applyTransform(di, animate) {
      domIndex = di;
      var px = calcTranslateX(di);
      if (animate) {
        track.style.transition = TRACK_EASE;
      } else {
        track.style.transition = 'none';
      }
      track.style.transform = 'translateX(' + px + 'px)';

      allSlideEls.forEach(function (el, j) {
        if (animate) {
          el.style.transition = OPACITY_EASE;
        } else {
          el.style.transition = 'none';
        }
        el.classList.toggle('is-active', j === di);
      });

      if (!animate) {
        void track.offsetWidth;
      }
    }

    function setRealIndex(ri) {
      realIndex = ri;
      realSlideEls.forEach(function (el, j) {
        el.setAttribute('aria-hidden', j === realIndex ? 'false' : 'true');
      });
    }

    function refreshDots() {
      var moved = prevDotsIndex >= 0 && prevDotsIndex !== realIndex;
      window.clearTimeout(shapeTimer);

      slotEls.forEach(function (slot, i) {
        var grow = slot.querySelector('.bp-swiper__dot-grow');
        var fill = slot.querySelector('[data-carousel-grow-fill]');
        if (grow) grow.classList.toggle('is-active', i === realIndex);
        if (fill) fill.classList.remove('bp-swiper__dot-grow-fill--animating');
      });

      var activeFill = slotEls[realIndex] ? slotEls[realIndex].querySelector('[data-carousel-grow-fill]') : null;

      var startFill = function () {
        if (!activeFill || !(activeFill instanceof HTMLElement)) return;
        if (reduceMotion) return;
        void activeFill.offsetWidth;
        activeFill.classList.add('bp-swiper__dot-grow-fill--animating');
      };

      if (moved && !reduceMotion) {
        shapeTimer = window.setTimeout(startFill, SHAPE_SETTLE_MS);
      } else {
        requestAnimationFrame(startFill);
      }

      prevDotsIndex = realIndex;
    }

    function syncAutoplayPause() {
      root.classList.toggle('is-paused', hoverPaused || holdPaused || tapPaused);
    }

    function go(delta) {
      if (sliding || !ready) return;
      var nextReal = (realIndex + delta + n) % n;
      var nextDom = domIndex + delta;
      sliding = true;
      setRealIndex(nextReal);
      applyTransform(nextDom, true);
      refreshDots();
    }

    if (track) {
      track.addEventListener('transitionend', function (e) {
        if (e.target !== track) return;
        if (domIndex === 0) {
          applyTransform(n, false);
        } else if (domIndex === n + 1) {
          applyTransform(1, false);
        }
        sliding = false;
      });
    }

    prevBtn && prevBtn.addEventListener('click', function () { go(-1); });
    nextBtn && nextBtn.addEventListener('click', function () { go(1); });

    slotEls.forEach(function (slot, i) {
      var fill = slot.querySelector('[data-carousel-grow-fill]');
      if (fill) {
        fill.addEventListener('animationend', function (e) {
          if (e.animationName !== ANIM_NAME) return;
          if (i !== realIndex) return;
          go(1);
        });
      }
    });

    /* ---- Pointer / touch drag ---- */
    if (viewport && track) {
      var dragging = false;
      var startX = 0;
      var startY = 0;
      var dragDelta = 0;
      var dragDeltaY = 0;
      var activePointer = '';
      var THRESHOLD = 40;

      function applyDragOffset(px) {
        var base = calcTranslateX(domIndex);
        track.style.transition = 'none';
        track.style.transform = 'translateX(' + (base + px) + 'px)';
      }

      function onDown(e) {
        if (!ready) return;
        if (e.button && e.button !== 0) return;
        dragging = true;
        activePointer = e.pointerType || (e.touches ? 'touch' : 'mouse');
        startX = e.touches ? e.touches[0].clientX : e.clientX;
        startY = e.touches ? e.touches[0].clientY : e.clientY;
        dragDelta = 0;
        dragDeltaY = 0;
        track.style.transition = 'none';
        viewport.style.cursor = 'grabbing';
        if (activePointer === 'touch') {
          lastTouchAt = Date.now();
          holdPaused = true;
          syncAutoplayPause();
        }
      }

      function onMove(e) {
        if (!dragging) return;
        var clientX = e.touches ? e.touches[0].clientX : e.clientX;
        var clientY = e.touches ? e.touches[0].clientY : e.clientY;
        dragDelta = clientX - startX;
        dragDeltaY = clientY - startY;
        applyDragOffset(dragDelta);
      }

      function onUp(e) {
        if (!dragging) return;
        dragging = false;
        viewport.style.cursor = '';
        var pointerType = (e && e.pointerType) || activePointer;
        var canceled = e && (e.type === 'pointercancel' || e.type === 'touchcancel' || e.type === 'pointerleave');
        var swiped = Math.abs(dragDelta) > THRESHOLD;
        var tapped = Math.abs(dragDelta) <= THRESHOLD && Math.abs(dragDeltaY) <= THRESHOLD;
        holdPaused = false;

        if (swiped) {
          syncAutoplayPause();
          go(dragDelta < 0 ? 1 : -1);
        } else {
          if (!canceled && pointerType === 'touch' && tapped) {
            tapPaused = !tapPaused;
          }
          syncAutoplayPause();
          applyTransform(domIndex, true);
        }
      }

      viewport.addEventListener('pointerdown', onDown);
      viewport.addEventListener('pointermove', onMove);
      viewport.addEventListener('pointerup', onUp);
      viewport.addEventListener('pointercancel', onUp);
      viewport.addEventListener('pointerleave', onUp);

      viewport.addEventListener('touchstart', onDown, { passive: true });
      viewport.addEventListener('touchmove', onMove, { passive: true });
      viewport.addEventListener('touchend', onUp);
      viewport.addEventListener('touchcancel', onUp);

      viewport.style.touchAction = 'pan-y';
      viewport.style.cursor = 'grab';
      viewport.style.userSelect = 'none';

      viewport.addEventListener('dragstart', function (e) { e.preventDefault(); });

      /* Pause only while the pointer is over a slide image.
         Touch taps toggle pause; a recent touch is ignored so mobile
         doesn't get stuck on the synthetic mouseenter that follows a tap. */
      var hoverCount = 0;
      allSlideEls.forEach(function (slide) {
        slide.addEventListener('mouseenter', function () {
          if (Date.now() - lastTouchAt < 1000) return;
          hoverCount += 1;
          hoverPaused = true;
          syncAutoplayPause();
        });
        slide.addEventListener('mouseleave', function () {
          if (Date.now() - lastTouchAt < 1000) return;
          hoverCount = Math.max(0, hoverCount - 1);
          hoverPaused = hoverCount > 0;
          syncAutoplayPause();
        });
      });
    }

    /* ---- Decode all images, then enable ---- */
    setRealIndex(0);
    applyTransform(1, false);

    var imgs = track ? [].slice.call(track.querySelectorAll('img')) : [];

    function decodeAll() {
      return Promise.all(imgs.map(function (img) {
        return new Promise(function (resolve) {
          if (img.complete && img.naturalWidth > 0) {
            if (img.decode) {
              img.decode().then(resolve).catch(resolve);
            } else {
              resolve();
            }
          } else {
            img.addEventListener('load', function () {
              if (img.decode) {
                img.decode().then(resolve).catch(resolve);
              } else {
                resolve();
              }
            }, { once: true });
            img.addEventListener('error', resolve, { once: true });
          }
        });
      }));
    }

    decodeAll().then(function () {
      ready = true;
      refreshDots();
    });

    var resizeTimer = 0;
    window.addEventListener('resize', function () {
      sliding = false;
      clearTimeout(resizeTimer);
      applyTransform(domIndex, false);
      resizeTimer = setTimeout(function () {
        applyTransform(domIndex, false);
      }, 150);
    });
  })();
</script>

