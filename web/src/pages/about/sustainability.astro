---
import { getImage } from 'astro:assets';
import Mainlayout from '../../layouts/Mainlayout.astro';
import ReachOut from '../../components/ReachOut.astro';

import heroImg from '../../assets/sustainability/2b1c7fecc62f5fca81aed1dd6ddb8c826af6c0e6.png';
import circularShuertImg from '../../assets/sustainability/circular-shuert.png';
import circularMarketImg from '../../assets/sustainability/circular-market.png';
import circularSourceImg from '../../assets/sustainability/circular-source.png';
import circularArrow from '../../assets/sustainability/circular-arrow.svg?url';
import epdBannerImg from '../../assets/sustainability/85331bec7d0ac395c87259c636f3b0c7a7f93e2e.png';
import statsBgImg from '../../assets/sustainability/c3dec68fe17e3211b5d828f9cae8466d0b8e88ef.png';
import driversImg from '../../assets/sustainability/8f0ab7b6a38251e847e6866d5a0909f4cfdc455c.png';
import repairsImg from '../../assets/sustainability/63de1bc7c9aec49488fabe299c98980178d6f6da.png';
import inspectionsImg from '../../assets/sustainability/feadd0c1312b90f0dd2436dd0af5c8e4e0cb4e79.png';
import reachOutImg from '../../assets/sustainability/60c26e97b304b786a121896cb8a9ba9c10e748e0.jpg';

import playIcon from '../../assets/sustainability/42208bd656b84eb6378eaaeb7657c54f8badc043.svg?url';
import arrowDownIcon from '../../assets/sustainability/7130bc65c3074ac9d2a540bd8be3b07ebb8458db.svg?url';

const heroOpt = await getImage({ src: heroImg, width: 2400, format: 'webp', quality: 80 });
const [circularShuertOpt, circularMarketOpt, circularSourceOpt] = await Promise.all(
  [circularShuertImg, circularMarketImg, circularSourceImg].map((src) =>
    getImage({ src, width: 1024, format: 'webp', quality: 90 }),
  ),
);
const epdOpt = await getImage({ src: epdBannerImg, width: 2400, format: 'webp', quality: 80 });
const statsOpt = await getImage({ src: statsBgImg, width: 1600, format: 'webp', quality: 80 });
const driversOpt = await getImage({ src: driversImg, width: 1800, format: 'webp', quality: 80 });
const repairsOpt = await getImage({ src: repairsImg, width: 1800, format: 'webp', quality: 80 });
const inspectionsOpt = await getImage({ src: inspectionsImg, width: 1800, format: 'webp', quality: 80 });

/** Chart scale: ±2 kg CO2-eq. Positive = above zero, negative = below. */
const chartStages = [
  {
    label: 'production',
    code: 'A1 - A4',
    wood: -1.21,
    woodLabel: '-1.21',
    plastic: 0.5,
    plasticLabel: '0.50',
  },
  {
    label: 'use',
    code: 'B1',
    wood: 0.33,
    woodLabel: '0.33',
    plastic: 0.2,
    plasticLabel: '0.20',
  },
  {
    label: 'maintenance',
    code: 'B2',
    wood: 0.67,
    woodLabel: '0.67',
    plastic: 0.06,
    plasticLabel: '0.06',
  },
  {
    label: 'end-of-life',
    code: 'C',
    wood: 1.6,
    woodLabel: '1.6',
    plastic: 0.16,
    plasticLabel: '0.16',
  },
] as const;

const yTicks = [2, 1.5, 1, 0.5, 0, -0.5, -1, -1.5, -2] as const;
---

<Mainlayout title="Sustainability">
  <!-- Hero -->
  <section class="su-hero">
    <div class="su-hero__bg" aria-hidden="true">
      <img
        src={heroOpt.src}
        alt=""
        class="su-hero__img"
        width={heroOpt.attributes.width}
        height={heroOpt.attributes.height}
        loading="eager"
        decoding="async"
      />
      <div class="su-hero__gradient"></div>
    </div>
    <div class="su-hero__content container">
      <div class="page-grid su-hero__grid">
        <div class="su-hero__left">
          <p class="su-hero__breadcrumb">
            <a href="/" class="su-hero__breadcrumb--dim">HOME</a>
            <span class="su-hero__breadcrumb--dim" aria-hidden="true">&ensp;/&ensp;</span>
            <a href="/about" class="su-hero__breadcrumb--dim">ABOUT</a>
            <span class="su-hero__breadcrumb--dim" aria-hidden="true">&ensp;/&ensp;</span>
            SUSTAINABILITY
          </p>
          <h1 class="detail-xl text-white su-hero__title">sustainability</h1>
        </div>
      </div>
      <a class="su-hero__watch" href="#" aria-label="Watch video">
        <span class="su-hero__watch-label">WATCH</span>
        <img src={playIcon} alt="" width="50" height="50" class="su-hero__watch-icon" />
      </a>
    </div>
  </section>

  <!-- Approach: Built to Last -->
  <section class="su-approach">
    <div class="container">
      <div class="su-approach__intro page-grid reveal">
        <div class="su-approach__intro-left">
          <p class="label su-approach__eyebrow">APPROACH</p>
          <h2 class="su-approach__title">Built to Last</h2>
        </div>
        <p class="su-approach__lede">
          Sustainability is easier to claim than to measure. At Shuert, we've come to believe that the real environmental case for a product isn't made by what it's manufactured from—it's made by how it performs over its full life cycle, in real-world systems, at scale.
        </p>
      </div>

      <div class="su-approach__split">
        <div
          class="su-approach__diagram"
          role="img"
          aria-label="Circular ecosystem: Shuert, the market, and the manufacturer connected in a loop"
        >
          <img
            class="su-eco__building su-eco__building--shuert"
            src={circularShuertOpt.src}
            alt=""
            width={circularShuertOpt.attributes.width}
            height={circularShuertOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
          <img
            class="su-eco__building su-eco__building--market"
            src={circularMarketOpt.src}
            alt=""
            width={circularMarketOpt.attributes.width}
            height={circularMarketOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
          <img
            class="su-eco__building su-eco__building--source"
            src={circularSourceOpt.src}
            alt=""
            width={circularSourceOpt.attributes.width}
            height={circularSourceOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
          <span class="su-eco__arrow su-eco__arrow--out" aria-hidden="true">
            <span class="su-eco__arrow-art"><img src={circularArrow} alt="" /></span>
          </span>
          <span class="su-eco__arrow su-eco__arrow--back" aria-hidden="true">
            <span class="su-eco__arrow-rot">
              <span class="su-eco__arrow-art"><img src={circularArrow} alt="" /></span>
            </span>
          </span>
          <span class="su-eco__arrow su-eco__arrow--forward" aria-hidden="true">
            <span class="su-eco__arrow-rot">
              <span class="su-eco__arrow-art"><img src={circularArrow} alt="" /></span>
            </span>
          </span>
        </div>
        <div class="su-approach__copy reveal">
          <h3 class="su-approach__copy-title">Circular Ecosystem</h3>
          <div class="su-approach__copy-body">
            <p>
              Most delivery systems waste more than they return. Smart Retur (SR) is replacing that model with a circular one—purchasing, pooling, collecting, repairing, and recirculating pallets across Scandinavian supply chains through a fully managed pooling system.
            </p>
            <p>
              Reusable packaging makes the model possible. The format is what makes it perform. That's why Smart Retur standardizes on the Uni-Pallet.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EPD banner -->
  <section class="su-epd">
    <div class="container">
      <div class="su-epd__panel">
        <img
          src={epdOpt.src}
          alt=""
          class="su-epd__img"
          width={epdOpt.attributes.width}
          height={epdOpt.attributes.height}
          loading="lazy"
          decoding="async"
        />
        <div class="su-epd__gradient" aria-hidden="true"></div>
        <span class="su-epd__badge">Wood Vs Plastic</span>
        <p class="su-epd__text">
          In 2023, an EPD (Environmental Product Declaration) of Shuert’s Uni-Directional 1,200 mm x 800 mm and the wood Euro Pallet 1,200 mm x 800 mm was conducted, examining both products’ environmental performance through their entire life cycle when used in the Smart Retur ecosystem within Norway on a per loop basis.
        </p>
        <a class="su-epd__cta" href="#lifecycle-results">
          <span>see the results</span>
          <img src={arrowDownIcon} alt="" width="50" height="50" class="su-epd__cta-icon" />
        </a>
      </div>
    </div>
  </section>

  <!-- Lifecycle case -->
  <section class="su-lifecycle" id="lifecycle-results">
    <div class="container">
      <div class="su-lifecycle__intro page-grid reveal">
        <div class="su-lifecycle__intro-left">
          <p class="label su-lifecycle__eyebrow">OUR EFFORTS</p>
          <h2 class="su-lifecycle__title">The Lifecycle Case for Plastic Pallets</h2>
        </div>
        <p class="su-lifecycle__lede">
          In a pooled, high-reuse system like Smart Retur, plastic pallets can deliver lower CO₂ per loop—driven by their physical design, which enables higher reuse, fewer handling events, and more efficient logistics.
        </p>
      </div>

      <div class="su-lifecycle__data">
        <div class="su-chart" aria-labelledby="su-chart-title">
          <div class="su-chart__head">
            <h3 class="su-chart__title" id="su-chart-title">stage-by-stage breakdown</h3>
            <div class="su-chart__legend">
              <span class="su-chart__pill su-chart__pill--wood">Wood Pallets</span>
              <span class="su-chart__pill su-chart__pill--plastic">Plastic Pallets</span>
            </div>
          </div>

          <div class="su-chart__plot">
            <div class="su-chart__y" aria-hidden="true">
              <span class="su-chart__unit">kg CO<sub>2</sub>-eq</span>
              {yTicks.map((tick) => (
                <span
                  class="su-chart__tick"
                  style={`--tick:${((2 - tick) / 4) * 100}%`}
                >
                  {tick === 0.5 ? '+.5' : tick === -0.5 ? '-.5' : tick > 0 ? `+${tick}` : `${tick}`}
                </span>
              ))}
            </div>

            <div class="su-chart__grid" aria-hidden="true">
              {yTicks.map((tick) => (
                <span
                  class:list={['su-chart__grid-line', { 'su-chart__grid-line--zero': tick === 0 }]}
                  style={`--tick:${((2 - tick) / 4) * 100}%`}
                />
              ))}
            </div>

            <div class="su-chart__cols" role="list">
              {chartStages.map((stage) => (
                <div class="su-chart__col" role="listitem">
                  <div class="su-chart__bars">
                    <div
                      class:list={[
                        'su-chart__bar',
                        'su-chart__bar--wood',
                        stage.wood < 0 ? 'su-chart__bar--neg' : 'su-chart__bar--pos',
                      ]}
                      style={`--val:${Math.abs(stage.wood)}`}
                    >
                      <span class="su-chart__val">{stage.woodLabel}</span>
                    </div>
                    <div
                      class:list={[
                        'su-chart__bar',
                        'su-chart__bar--plastic',
                        stage.plastic < 0 ? 'su-chart__bar--neg' : 'su-chart__bar--pos',
                      ]}
                      style={`--val:${Math.abs(stage.plastic)}`}
                    >
                      <span class="su-chart__val">{stage.plasticLabel}</span>
                    </div>
                  </div>
                  <div class="su-chart__xlabel">
                    <span class="su-chart__xlabel-main">{stage.label}</span>
                    <span class="su-chart__xlabel-code">{stage.code}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside class="su-stat">
          <img
            src={statsOpt.src}
            alt=""
            class="su-stat__img"
            width={statsOpt.attributes.width}
            height={statsOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
          <div class="su-stat__overlay" aria-hidden="true"></div>
          <div class="su-stat__totals">
            <div class="su-stat__total">
              <p class="su-stat__total-label">WOOD PALLET — TOTAL</p>
              <p class="su-stat__total-value">
                <span>1.39</span>
                <span class="su-stat__total-unit">kg CO2-eq per loop</span>
              </p>
            </div>
            <div class="su-stat__divider" aria-hidden="true"></div>
            <div class="su-stat__total">
              <p class="su-stat__total-label">PLASTIC PALLET — TOTAL</p>
              <p class="su-stat__total-value">
                <span>0.92</span>
                <span class="su-stat__total-unit">kg CO2-eq per loop</span>
              </p>
            </div>
          </div>
          <div class="su-stat__main">
            <p class="su-stat__pct">34%</p>
            <p class="su-stat__sub">lower lifecycle emissions per loop</p>
            <p class="su-stat__body">
              Based on published Environmental Product Declaration (EPD) data, a reusable plastic pallet emits roughly half the CO-equivalent of a traditional wood pallet over its full lifecycle.
            </p>
          </div>
          <div class="su-stat__disclaimer">
            <p class="su-stat__disclaimer-label">DISCLAIMER</p>
            <p class="su-stat__disclaimer-body">
              Data is sourced from a third-party-verified and registered document aligned with international standards. Results depend on operational assumptions such as the number of loops (lifetime), transport distances, and repair and inspection rates.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Feature rows -->
  <section class="su-features">
    <div class="container">
      <article class="su-feature">
        <div class="su-feature__media">
          <img
            src={driversOpt.src}
            alt="Industrial manufacturing equipment"
            width={driversOpt.attributes.width}
            height={driversOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="su-feature__copy reveal">
          <h3 class="su-feature__title">
            Key Drivers of Environmental<br />Performance
          </h3>
          <div class="su-feature__body">
            <p>
              Plastic pallets are lighter than wood pallets, which reduces transported mass per trip and can lower fuel consumption in transport-intensive systems.
            </p>
            <p>
              <strong>Smart Retur Plastic Pallet:</strong> 15 kg<br />
              <strong>EUR Pallet:</strong> 25 kg
            </p>
            <p>
              Plastic pallets are more durable and require fewer repairs and inspections, which reduces handling steps, transport movements, and associated emissions.
            </p>
          </div>
        </div>
      </article>

      <article class="su-feature su-feature--reverse">
        <div class="su-feature__copy reveal">
          <h3 class="su-feature__title">Repairs</h3>
          <div class="su-feature__body">
            <p>
              We repair crates and pallets whenever possible instead of replacing them. Reuse and longevity are at the core of a circular economy, and repair is one of our key sustainability priorities. Here's how often repair is actually needed, by pallet type:
            </p>
            <p>
              <strong>Smart Retur Plastic Pallet:</strong> 1% of incoming pallets need repair<br />
              <strong>EUR Pallet:</strong> 30% of incoming pallets need repair
            </p>
          </div>
        </div>
        <div class="su-feature__media">
          <img
            src={repairsOpt.src}
            alt="Technician repairing a plastic packaging component"
            width={repairsOpt.attributes.width}
            height={repairsOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>

      <article class="su-feature">
        <div class="su-feature__media">
          <img
            src={inspectionsOpt.src}
            alt="Stack of reusable plastic pallets"
            width={inspectionsOpt.attributes.width}
            height={inspectionsOpt.attributes.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="su-feature__copy reveal">
          <h3 class="su-feature__title">Inspections</h3>
          <div class="su-feature__body">
            <p>
              A longer service life (i.e., more loops per pallet) allows production impacts to be distributed over more uses, reducing the CO2 footprint per-loop.
            </p>
            <p>
              <strong>Smart Retur Plastic Pallet:</strong> 20% of pallets inspected per loop<br />
              <strong>EUR Pallet:</strong> 100% of pallets inspected per loop
            </p>
            <p>
              Plastic pallets are made from HDPE and are recyclable at end-of-life, enabling material recovery and energy recovery and reducing the need for virgin material production.
            </p>
            <p>
              <strong>Smart Retur Plastic Pallet:</strong> 100 loops per pallet<br />
              <strong>EUR Pallet:</strong> 24 loops per pallet
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <ReachOut
    image={reachOutImg}
    imageAlt="Forklift and stacked reusable pallets in a Shuert warehouse"
  />

</Mainlayout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    reveals.forEach((el) => observer.observe(el));
  }

</script>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .su-hero {
    position: relative;
    height: clamp(500px, 46.4vw, 802px);
    overflow: hidden;
    background: var(--c-black);
  }

  .su-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .su-hero__img {
    position: absolute;
    width: 100%;
    height: 121.2%;
    top: -17.19%;
    left: 0;
    max-width: none;
    object-fit: cover;
  }

  .su-hero__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 63.12%, rgb(0, 0, 0) 88.95%),
      linear-gradient(0deg, rgba(0, 0, 0, 0) 64.59%, rgb(0, 0, 0) 100%);
  }

  .su-hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(1.5rem, 3.18vw, 60px);
  }

  .su-hero__grid {
    align-items: end;
    width: 100%;
  }

  .su-hero__left {
    grid-column: 1 / 11;
  }

  .su-hero__breadcrumb {
    margin: 0 0 29px;
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
    color: var(--c-white);
  }

  .su-hero__breadcrumb--dim {
    color: rgba(255, 255, 255, 0.35);
  }

  .su-hero__breadcrumb a.su-hero__breadcrumb--dim {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .su-hero__breadcrumb a.su-hero__breadcrumb--dim:hover,
  .su-hero__breadcrumb a.su-hero__breadcrumb--dim:focus-visible {
    color: rgba(255, 255, 255, 0.75);
  }

  .su-hero__title {
    margin: 0;
    /* Pull text slightly left to match Figma optical baseline (59 vs 65) */
    margin-left: -6px;
  }

  .su-hero__watch {
    position: absolute;
    right: var(--grid-margin);
    bottom: clamp(1.5rem, 3.18vw, 60px);
    display: flex;
    align-items: center;
    gap: 17px;
    text-decoration: none;
    color: var(--c-white);
    z-index: 2;
  }

  .su-hero__watch-label {
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
  }

  .su-hero__watch-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .su-hero__watch:hover .su-hero__watch-icon {
    opacity: 0.75;
  }

  /* ================================================================
     APPROACH
     ================================================================ */
  .su-approach {
    background: var(--c-sec-1);
    padding: 65px 0 100px;
  }

  .su-approach__intro {
    align-items: start;
    margin-bottom: 80px;
  }

  .su-approach__intro-left {
    grid-column: 1 / 7;
  }

  .su-approach__eyebrow {
    margin: 0;
    color: var(--c-sec-3);
    letter-spacing: 1.54px;
  }

  .su-approach__title {
    margin: 15px 0 0;
    font: var(--w-light) 30px / 33px var(--ff-r);
    color: var(--c-black);
  }

  .su-approach__lede {
    grid-column: 7 / -1;
    margin: 0;
    font: var(--w-light) 25px / 32px var(--ff-r);
    color: var(--c-black);
    max-width: 779px;
  }

  .su-approach__split {
    display: grid;
    grid-template-columns: minmax(0, 924fr) minmax(0, 519fr);
    gap: clamp(2rem, 4.3vw, 74px);
    align-items: center;
  }

  .su-approach__diagram {
    position: relative;
    background: var(--c-white);
    border-radius: 14px;
    aspect-ratio: 924 / 662;
    overflow: hidden;
  }

  .su-eco__building {
    position: absolute;
    width: calc(572 / 924 * 100%);
    height: calc(572 / 662 * 100%);
    max-width: none;
    object-fit: cover;
    pointer-events: none;
  }

  .su-eco__building--shuert {
    left: calc(175 / 924 * 100%);
    top: calc(-112 / 662 * 100%);
  }

  .su-eco__building--market {
    left: calc(-55 / 924 * 100%);
    top: calc(161.8468 / 662 * 100%);
  }

  .su-eco__building--source {
    left: calc(407 / 924 * 100%);
    top: calc(161.8468 / 662 * 100%);
    object-position: bottom;
  }

  .su-eco__arrow {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .su-eco__arrow--out {
    left: calc(699 / 924 * 100%);
    top: calc(176 / 662 * 100%);
    width: calc(68.205 / 924 * 100%);
    height: calc(115.5 / 662 * 100%);
  }

  .su-eco__arrow--back {
    left: calc(126 / 924 * 100%);
    top: calc(181 / 662 * 100%);
    width: calc(133.788 / 924 * 100%);
    height: calc(112.498 / 662 * 100%);
  }

  .su-eco__arrow--forward {
    left: calc(385 / 924 * 100%);
    top: calc(503 / 662 * 100%);
    width: calc(133.896 / 924 * 100%);
    height: calc(121.115 / 662 * 100%);
  }

  .su-eco__arrow--back .su-eco__arrow-rot {
    width: calc(68.205 / 133.788 * 100%);
    height: calc(115.5 / 112.498 * 100%);
    transform: rotate(-116.44deg);
  }

  .su-eco__arrow--forward .su-eco__arrow-rot {
    width: calc(68.205 / 133.896 * 100%);
    height: calc(115.5 / 121.115 * 100%);
    transform: rotate(123.98deg);
  }

  .su-eco__arrow-rot {
    position: relative;
    flex: none;
  }

  .su-eco__arrow-art {
    position: absolute;
    inset: -0.82% -8.4% 0 -0.45%;
  }

  .su-eco__arrow--out .su-eco__arrow-art {
    inset: -0.82% -8.4% 0 -0.45%;
  }

  .su-eco__arrow-art img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .su-approach__copy-title {
    margin: 0 0 35px;
    font: var(--w-light) 30px / 33px var(--ff-r);
    color: var(--c-black);
  }

  .su-approach__copy-body {
