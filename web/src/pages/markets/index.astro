---
import Mainlayout from '../../layouts/Mainlayout.astro';
import ReachOut from '../../components/ReachOut.astro';
import heroImg from '../../assets/markets/Shuert_ProductPageHeaders_v01_Uni-Pak_v03 1.png';
import reachOutImg from '../../assets/markets/60c26e97b304b786a121896cb8a9ba9c10e748e0.jpg';

import iconAutomotive from '../../assets/markets/7c61e96fd523fbfee58ef2dc967fb250ae0ac962.svg?url';
import iconAgriculture from '../../assets/markets/499b89d1df290e0ae8c1f320fb7b23f10a622137.svg?url';
import iconAutomatedSystems from '../../assets/markets/icons/de93fcfedcf03d5655e8db3a6ba6457c846a11dc.svg?url';
import iconConstruction from '../../assets/markets/icons/5b22c06b70ec3036386d3d20b95af2bc8d4f059f.svg?url';
import iconEcommerce from '../../assets/markets/icons/a7ed618908dc64519a79e4cbaf13b4c59f869d3c.svg?url';
import iconFmcg from '../../assets/markets/6fcc977319170cad548333e2c75f6119f095e1fe.svg?url';
import iconGovernment from '../../assets/markets/icons/e72bc368592456ce65144abb508433e88f668788.svg?url';
import iconGrocery from '../../assets/markets/icons/156977db49fe852098cad76b3150ba7163f5ede2.svg?url';
import iconMilitary from '../../assets/markets/icons/4c09796fd555a39af27186dc1c245ea7636a60c4.svg?url';
import iconPharmaceutical from '../../assets/markets/icons/2f46978f98a439d59b5bbde69dbe119eba1123ce.svg?url';
import iconTextiles from '../../assets/markets/icons/514dc8e7a0da8562882f25c0a99b8eaee00342a8.svg?url';

const markets = [
  { name: 'Automotive', icon: iconAutomotive, iw: 36, ih: 27, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Agriculture', icon: iconAgriculture, iw: 35, ih: 35, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Automated Systems', icon: iconAutomatedSystems, iw: 28, ih: 35, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Construction', icon: iconConstruction, iw: 49, ih: 34, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'E-Commerce', icon: iconEcommerce, iw: 50, ih: 35, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Fast Moving Consumer Goods', icon: iconFmcg, iw: 34, ih: 34, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Government', icon: iconGovernment, iw: 36, ih: 34, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Grocery', icon: iconGrocery, iw: 34, ih: 35, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Military', icon: iconMilitary, iw: 28, ih: 34, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Pharmaceutical/Medical', icon: iconPharmaceutical, iw: 22, ih: 34, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
  { name: 'Textiles', icon: iconTextiles, iw: 26, ih: 33, desc: 'Lorem ipsum dolor sit amet consectetur. Eu condimentum at enim duis lectus pulvinar.' },
];
---

<Mainlayout title="Markets">
  <!-- Hero -->
  <section class="m-hero">
    <div class="m-hero__bg" aria-hidden="true">
      <img
        src={heroImg.src}
        alt=""
        class="m-hero__img"
        width={heroImg.width}
        height={heroImg.height}
        loading="eager"
        decoding="async"
      />
      <div class="m-hero__gradient"></div>
    </div>
    <div class="m-hero__content container">
      <div class="page-grid m-hero__grid">
        <div class="m-hero__left">
          <p class="m-hero__breadcrumb">
            <a href="/" class="m-hero__breadcrumb--dim">HOME</a><span class="m-hero__breadcrumb--dim" aria-hidden="true">&ensp;/&ensp;</span>ALL MARKETS
          </p>
          <h1 class="detail-xl text-white">markets</h1>
        </div>
        <div class="m-hero__right">
          <p class="m-hero__desc text-white">
            Lorem ipsum dolor sit amet consectetur. Donec gravida quam sit consequat eget dignissim. Tristique nibh tristique cum purus dictumst nec lorem magnis. Sed dolor odio arcu magna pellentesque sem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Markets Grid -->
  <section class="m-body">
    <div class="container">
      <div class="m-grid">
        {markets.map((market) => (
          <article class="m-cell">
            <div class="m-cell__top">
              <img class="m-cell__icon" src={market.icon} alt="" width={market.iw} height={market.ih} />
              <h3 class="m-cell__name">{market.name}</h3>
            </div>
            <p class="m-cell__desc">{market.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ReachOut
    image={reachOutImg}
    imageAlt="Forklift and stacked reusable pallets in a Shuert warehouse"
  />

</Mainlayout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    reveals.forEach((el) => observer.observe(el));
  }

</script>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .m-hero {
    position: relative;
    height: clamp(500px, 46.4vw, 802px);
    overflow: hidden;
    background: var(--c-black);
  }

  .m-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .m-hero__img {
    position: absolute;
    width: 100%;
    height: 121.2%;
    top: -11.46%;
    left: 0;
    max-width: none;
    object-fit: cover;
  }

  .m-hero__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 63.12%, rgb(0, 0, 0) 88.95%),
      linear-gradient(0deg, rgba(0, 0, 0, 0) 64.59%, rgb(0, 0, 0) 100%);
  }

  .m-hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(1.5rem, 3.18vw, 55px);
  }

  .m-hero__grid {
    align-items: end;
    width: 100%;
  }

  .m-hero__left {
    grid-column: 1 / 9;
  }

  .m-hero__breadcrumb {
    margin: 0 0 29px;
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
    color: var(--c-white);
  }

  .m-hero__breadcrumb--dim {
    color: rgba(255, 255, 255, 0.35);
  }

  .m-hero__breadcrumb a.m-hero__breadcrumb--dim {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .m-hero__breadcrumb a.m-hero__breadcrumb--dim:hover,
  .m-hero__breadcrumb a.m-hero__breadcrumb--dim:focus-visible {
    color: rgba(255, 255, 255, 0.75);
  }

  .m-hero__left .detail-xl {
    margin: 0;
  }

  .m-hero__right {
    grid-column: 9 / -1;
  }

  .m-hero__desc {
    margin: 0;
    font: var(--w-light) 16px / 22px var(--ff-r);
    max-width: 520px;
  }

  /* ================================================================
     MARKETS BODY (cream background)
     ================================================================ */
  .m-body {
    background: var(--c-sec-1);
    padding: 68px 0 100px;
  }

  /* ================================================================
     MARKETS GRID
     ================================================================ */
  .m-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .m-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-sizing: border-box;
    padding: 25px 33px 52px 3px;
    border-bottom: 1px solid #ebe7e3;
    border-right: 1px solid #ebe7e3;
    min-height: 226px;
  }

  .m-cell:nth-child(3n + 2) {
    padding-left: 33px;
    padding-right: 33px;
  }

  .m-cell:nth-child(3n) {
    border-right: none;
    padding-left: 33px;
    padding-right: 0;
  }

  .m-cell:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .m-cell:nth-child(10) {
    border-bottom: none;
  }

  .m-cell__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }

  .m-cell__icon {
    flex-shrink: 0;
    width: auto;
    height: 35px;
    object-fit: contain;
    object-position: left center;
  }

  .m-cell__name {
    margin: 0;
    font-family: var(--ff-r);
    font-weight: var(--w-medium);
    font-size: 30px;
    line-height: 33px;
    color: var(--c-black);
    letter-spacing: 0;
  }

  .m-cell__desc {
    margin: 0;
    font: var(--w-light) 16px / 22px var(--ff-r);
    color: var(--c-black);
    max-width: 332px;
  }

  /* ================================================================
     REVEAL ANIMATION
     ================================================================ */
  .reveal {
    opacity: 0;
    transform: translateY(60px);
    transition:
      opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal--visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ================================================================
     TABLET (≤ 1024px)
     ================================================================ */
  @media (max-width: 64rem) {
    .m-hero {
      height: clamp(420px, 55vw, 640px);
    }

    .m-hero__left {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    .m-hero__right {
      grid-column: 1 / -1;
      margin-top: 1.25rem;
    }

    .m-hero__desc {
      max-width: none;
    }

    .m-body {
      padding: 40px 0 64px;
    }

    .m-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .m-cell {
      min-height: auto;
      padding: 24px 0;
      border-right: none;
    }

    .m-cell:nth-child(3n + 2),
    .m-cell:nth-child(3n) {
      padding-left: 0;
      padding-right: 0;
    }

    .m-cell:nth-child(odd) {
      border-right: 1px solid #ebe7e3;
      padding-right: 24px;
    }

    .m-cell:nth-child(even) {
      padding-left: 24px;
    }

    .m-cell:nth-last-child(-n + 2) {
      border-bottom: 1px solid #ebe7e3;
    }

    .m-cell:last-child {
      border-bottom: none;
    }

    .m-cell:nth-last-child(1):nth-child(odd) {
      border-bottom: none;
    }

    .m-cell:nth-child(10) {
      border-bottom: 1px solid #ebe7e3;
    }

    .m-cell__name {
      font-size: 24px;
      line-height: 28px;
    }

  }

  /* ================================================================
     MOBILE (≤ 768px)
     ================================================================ */
  @media (max-width: 48rem) {
    .m-hero {
      height: clamp(360px, 80vw, 500px);
    }

    .m-hero__img {
      width: 160%;
      left: -40%;
    }

    .m-body {
      padding: 32px 0 48px;
    }

    .m-grid {
      grid-template-columns: 1fr;
    }

    .m-cell {
      padding: 24px 0;
      border-right: none !important;
    }

    .m-cell:nth-child(odd) {
      padding-right: 0;
    }

    .m-cell:nth-child(even) {
      padding-left: 0;
    }

    .m-cell:nth-child(10) {
      border-bottom: 1px solid #ebe7e3;
    }

    .m-cell:last-child {
      border-bottom: none;
    }

    .m-cell__name {
      font-size: 22px;
      line-height: 26px;
    }
  }
</style>
