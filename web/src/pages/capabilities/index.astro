---
import type { ImageMetadata } from 'astro:assets';
import Mainlayout from '../../layouts/Mainlayout.astro';
import ReachOut from '../../components/ReachOut.astro';
import heroImg from '../../assets/capabilities/d0898f74e6a17d8157762d57261d2b429feb1f29.png';
import reachOutImg from '../../assets/capabilities/60c26e97b304b786a121896cb8a9ba9c10e748e0.jpg';
import playIcon from '../../assets/capabilities/42208bd656b84eb6378eaaeb7657c54f8badc043.svg?url';

import img01 from '../../assets/capabilities/cb3b6eafff44df7558209d756b6695b8aba566e1.png';
import img02 from '../../assets/capabilities/a6d9ba3ad0c7d6f3ebaac9ecad6d00dfd962098b.png';
import img03 from '../../assets/capabilities/04896979f7eaa8c7c63cacdad52dff39383582b7.png';
import img04 from '../../assets/capabilities/0480e4649dac68afe571e55ee77e5c481440aef4.png';
import img05 from '../../assets/capabilities/Rectangle 31.png';
import img06 from '../../assets/capabilities/cd6fd03d8db6e3678c1a0acaf59d04ac6dffabdb.png';
import img07 from '../../assets/capabilities/51397d888bd35118acfaf303ace464ec4fcf87c1.png';
import img08 from '../../assets/capabilities/2b1c7fecc62f5fca81aed1dd6ddb8c826af6c0e6.png';

type Capability = {
  num: string;
  title: string;
  img: ImageMetadata;
  paragraphs: string[];
  capacity?: string[];
  recycling?: boolean;
};

const capabilities: Capability[] = [
  {
    num: '01',
    title: 'Design & Engineering',
    img: img01,
    paragraphs: [
      "Hey, what's your problem is a simple question, but it's where every project starts. Shipping and material handling challenges are never identical—products, processes, environments, and performance requirements all shape what the solution needs to do. So we start with your problem and build from there. It's how we've delivered more than 2,000 unique designs with our partners, combining the right technology with hands-on experience under one roof.",
    ],
  },
  {
    num: '02',
    title: 'Prototyping',
    img: img02,
    paragraphs: [
      'Prototyping lets us validate design concepts before committing to production tooling. Once a concept is approved, we produce two wood patterns in parallel: one to fabricate prototype components and one to develop the aluminum tooling used in production. Prototypes are evaluated for form, fit, and function at our testing facility, where iterations are refined on-site before the design is finalized.',
      'This parallel approach keeps prototype validation and full-scale manufacturing in step, minimizing the gap between design intent and production reality.',
    ],
  },
  {
    num: '03',
    title: 'Tool Fabrication',
    img: img03,
    paragraphs: [
      'Our in-house tool fabrication lets us build the production tooling needed to manufacture components at scale, so every part is formed consistently and to specification. Once concepts are finalized, wood patterns go to the foundry to be cast in aluminum. The castings are then fabricated, machined, and assembled into completed molds, along with any auxiliary tooling needed to support forming and improve part quality.',
      'Building effective tooling takes both craftsmanship and technical skill. Toolmakers must be proficient in metal fabrication while also understanding how tool construction influences heat transfer, material draw, and part formation during thermoforming. The result is molds built not just to specification, but to perform reliably in production.',
    ],
  },
  {
    num: '04',
    title: 'Extrusion',
    img: img04,
    paragraphs: [
      'Extrusion converts raw thermoplastic into the continuous sheet used in our thermoforming, and producing it in-house gives us control from raw material through part formation. Material is fed into a single-screw extruder, melted and blended to a uniform consistency, then extruded through a die and sized, cooled, and cut to specification.',
      'This lets us hold critical specifications like thickness, density, and material distribution, ensuring predictable behavior during forming. The result is consistent input material that directly drives part performance, repeatability, and long-term durability.',
    ],
    capacity: [
      '10 high-capacity extrusion lines',
      'Over 200 million pounds of thermoplastic processed annually',
      '12 material silos supporting railcar delivery and pneumatic distribution to production lines',
    ],
  },
  {
    num: '05',
    title: 'Thermoforming',
    img: img05,
    paragraphs: [
      'Thermoforming is the primary process we use to produce reusable packaging systems. We support both single-sheet and twin-sheet forming, with a focus on twin-sheet where structural performance is critical. In twin-sheet forming, two heated sheets are formed against matched molds and fused at defined contact points (knitting), creating a single hollow structure with internal features.',
      'Strength comes from the separation between surfaces rather than solid mass, increasing rigidity without adding material thickness. The result is a lightweight, load-bearing, impact-resistant structure built for consistent performance and long service life.',
    ],
    capacity: [
      '17 thermoforming lines dedicated to high-volume output',
      '140,000 annual production hours across continuous 24/7 operations',
      '6-8 million components annually, converting extruded sheet into precision-formed reusable parts',
    ],
  },
  {
    num: '06',
    title: 'Injection Molding',
    img: img06,
    paragraphs: [
      'Injection molding lets us produce small, high-volume components that integrate with and enhance our thermoformed structures. Thermoplastic is melted and injected under pressure into a closed mold, where it cools and solidifies into its final shape.',
      'These components add functional features such as slide locks, Klips (Shuert-branded fasteners), and RFID tag holders that support assembly, handling, and system integration. The result is a more complete, application-specific solution with consistency across every component.',
    ],
    capacity: ['4 injection molding lines'],
  },
  {
    num: '07',
    title: 'Sleeve Fabrication',
    img: img07,
    paragraphs: [
      'Sleeve fabrication allows us to convert polypropylene boardstock into sleeves that integrate with our pallet and cover, forming a complete packaging system—the Uni-Pak.',
      'Each sleeve is die-cut to the required container height and the pallet and cover footprints, ensuring a precise fit within the system. Creasing defines the sleeve’s geometry by forming the vertical corners, while welding joins the two ends to create a continuous, durable structure.',
      'Custom print options are available to align with customer branding, along with the integration of additional features and fittings to support specific application requirements.',
    ],
  },
  {
    num: '08',
    title: 'Recycling',
    img: img08,
    paragraphs: [],
    recycling: true,
  },
];
---

<Mainlayout title="Capabilities">
  <!-- Hero -->
  <section class="c-hero">
    <div class="c-hero__bg" aria-hidden="true">
      <img
        src={heroImg.src}
        alt=""
        class="c-hero__img"
        width={heroImg.width}
        height={heroImg.height}
        loading="eager"
        decoding="async"
      />
      <div class="c-hero__gradient"></div>
    </div>
    <div class="c-hero__content container">
      <div class="page-grid c-hero__grid">
        <div class="c-hero__left">
          <p class="c-hero__breadcrumb">
            <a href="/" class="c-hero__breadcrumb--dim">HOME</a><span class="c-hero__breadcrumb--dim" aria-hidden="true">&ensp;/&ensp;</span>CAPABILITIES
          </p>
          <h1 class="detail-xl text-white c-hero__title">capabilities</h1>
        </div>
      </div>
      <a class="c-hero__watch" href="#" aria-label="Watch video">
        <span class="c-hero__watch-label">WATCH</span>
        <img src={playIcon} alt="" width="50" height="50" class="c-hero__watch-icon" />
      </a>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="c-body">
    <div class="container">
      <div class="c-intro page-grid">
        <div class="c-intro__left">
          <p class="label c-intro__eyebrow">VERTICALLY INTEGRATED</p>
          <h2 class="c-intro__title">From Concept to Production</h2>
        </div>
        <p class="c-intro__desc">
          On our 20-acre campus are 470 thousand sqft of office, production, and warehousing space to support management, research and development, extrusion, thermoforming, sleeve, and assembly operations – with capacity for continued expansion as demand grows.
        </p>
      </div>
    </div>

    <div class="container c-body__rows">
      {capabilities.map((cap, i) => (
        <article class:list={['c-row page-grid', { 'c-row--reverse': i % 2 !== 0 }]}>
          <div class="c-row__img-wrap">
            <img
              src={cap.img.src}
              alt={cap.title}
              class="c-row__img"
              width={cap.img.width}
              height={cap.img.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="c-row__text reveal">
            <div class="c-row__head">
              <span class="c-row__number">{cap.num}</span>
              <h2 class="c-row__title">{cap.title}</h2>
            </div>

            {cap.recycling ? (
              <div class="c-row__desc c-row__desc--rich">
                <p>
                  All Shuert products are fully recyclable and can be reprocessed multiple times without significant material degradation—offering a zero-waste alternative to single-use formats. Our 150,000 pounds per day of recycling capacity supports continuous reprocessing across our manufacturing operations.
                </p>
                <p>
                  <strong>Post-Consumer Recycling.</strong> Through our buyback program, we compensate customers for their retired Shuert products. Recovered packaging is reprocessed and reintroduced into production, closing the loop so reclaimed material becomes the basis for the next generation of products.
                </p>
                <p class="c-row__subhead">Customer benefits include:</p>
                <ul class="c-row__bullets">
                  <li>Reduced waste disposal fees</li>
                  <li>Freed-up warehouse space</li>
                  <li>Direct payment for retired products</li>
                </ul>
                <p>
                  <strong>Post-Industrial Recycling.</strong> We recycle the waste generated within our own operations—diverting it from landfills through on-site collection and processing—and blend the reclaimed material with virgin resin to maintain the performance and consistency our products require.
                </p>
              </div>
            ) : (
              <div class="c-row__desc">
                {cap.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            )}

            {cap.capacity && (
              <div class="c-row__capacity">
                <p class="c-row__capacity-label">Capacity:</p>
                <ul class="c-row__capacity-list">
                  {cap.capacity.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <ReachOut
    image={reachOutImg}
    imageAlt="Forklift and stacked reusable pallets in a Shuert warehouse"
  />

</Mainlayout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    reveals.forEach((el) => observer.observe(el));
  }

</script>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .c-hero {
    position: relative;
    height: clamp(500px, 46.4vw, 802px);
    overflow: hidden;
    background: var(--c-black);
  }

  .c-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .c-hero__img {
    position: absolute;
    width: 100%;
    height: 121.2%;
    top: -21.18%;
    left: 0;
    max-width: none;
    object-fit: cover;
  }

  .c-hero__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 63.12%, rgb(0, 0, 0) 88.95%),
      linear-gradient(0deg, rgba(0, 0, 0, 0) 64.59%, rgba(0, 0, 0, 0.25) 100%);
  }

  .c-hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(1.5rem, 3.18vw, 60px);
  }

  .c-hero__grid {
    align-items: end;
    width: 100%;
  }

  .c-hero__left {
    grid-column: 1 / 11;
  }

  .c-hero__breadcrumb {
    margin: 0 0 29px;
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
    color: var(--c-white);
  }

  .c-hero__breadcrumb--dim {
    color: rgba(255, 255, 255, 0.35);
  }

  .c-hero__breadcrumb a.c-hero__breadcrumb--dim {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .c-hero__breadcrumb a.c-hero__breadcrumb--dim:hover,
  .c-hero__breadcrumb a.c-hero__breadcrumb--dim:focus-visible {
    color: rgba(255, 255, 255, 0.75);
  }

  .c-hero__title {
    margin: 0;
    /* Pull text slightly left to match Figma optical baseline (59 vs 65) */
    margin-left: -6px;
  }

  /* WATCH button */
  .c-hero__watch {
    position: absolute;
    right: var(--grid-margin);
    bottom: clamp(1.5rem, 3.18vw, 60px);
    display: flex;
    align-items: center;
    gap: 17px;
    text-decoration: none;
    color: var(--c-white);
    z-index: 2;
  }

  .c-hero__watch-label {
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
  }

  .c-hero__watch-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .c-hero__watch:hover .c-hero__watch-icon {
    opacity: 0.75;
  }

  /* ================================================================
     CAPABILITIES BODY (cream background)
     ================================================================ */
  .c-body {
    position: relative;
    background: var(--c-sec-1);
    padding: 65px 0 77px;
  }

  /* ================================================================
     INTRO (before first capability)
     ================================================================ */
  .c-intro {
    align-items: start;
  }

  .c-intro__left {
    grid-column: 1 / 7;
  }

  .c-intro__eyebrow {
    margin: 0;
    color: var(--c-sec-3);
    letter-spacing: 1.54px;
  }

  .c-intro__title {
    margin: 15px 0 0;
    font: var(--w-light) 30px / 33px var(--ff-r);
    color: var(--c-black);
    letter-spacing: 0;
  }

  .c-intro__desc {
    grid-column: 7 / -1;
    margin: 0;
    font: var(--w-light) 25px / 32px var(--ff-r);
    color: var(--c-black);
    max-width: 779px;
  }

  .c-body__rows {
    margin-top: 100px;
  }

  /* ================================================================
     CAPABILITY ROW
     ================================================================ */
  .c-row {
    align-items: center;
  }

  .c-row + .c-row {
    margin-top: 77px;
  }

  /* --- Default (odd): image left, text right --- */
  .c-row__img-wrap {
    grid-column: 1 / 8;
    border-radius: var(--r-img);
    overflow: hidden;
    aspect-ratio: 924 / 662;
    position: relative;
  }

  .c-row__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-row__text {
    grid-column: 8 / -1;
    padding-left: 55px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  /* --- Reversed (even): text left, image right --- */
  .c-row--reverse .c-row__img-wrap {
    grid-column: 6 / -1;
    grid-row: 1;
  }

  .c-row--reverse .c-row__text {
    grid-column: 1 / 6;
    grid-row: 1;
    padding-left: 58px;
  }

  /* --- Text elements --- */
  .c-row__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .c-row__number {
    font: var(--w-bold) 14px / 14px var(--ff-s);
    letter-spacing: 1.54px;
    text-transform: uppercase;
    color: var(--c-sec-3);
  }

  .c-row__title {
    margin: 0;
    font: var(--w-light) 30px / 33px var(--ff-r);
    color: var(--c-black);
    letter-spacing: 0;
  }

  .c-row__desc {
    margin: 30px 0 0;
    max-width: 519px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .c-row__desc p {
    margin: 0;
    font: var(--w-light) 16px / 22px var(--ff-r);
    color: var(--c-black);
  }

  .c-row__desc strong {
    font-weight: var(--w-semibold);
  }

  .c-row__subhead {
    margin: 0;
    font: var(--w-bold) 14px / 14px var(--ff-s);
    letter-spacing: 1.54px;
    text-transform: uppercase;
    color: var(--c-black);
  }

  .c-row__bullets {
    margin: 0;
    padding: 0 0 0 1.25em;
    list-style: disc;
  }

  .c-row__bullets li {
    font: var(--w-light) 12px / 16px var(--ff-r);
    color: var(--c-black);
  }

  .c-row__capacity {
    margin-top: 32px;
    max-width: 519px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .c-row__capacity-label {
    margin: 0;
    font: var(--w-bold) 14px / 14px var(--ff-s);
    letter-spacing: 1.54px;
    text-transform: uppercase;
    color: var(--c-black);
  }

  .c-row__capacity-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c-row__capacity-list li {
    position: relative;
    padding-left: 26px;
    font: var(--w-light) 12px / 16px var(--ff-r);
    color: var(--c-black);
  }

  .c-row__capacity-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    top: 0;
  }

  /* ================================================================
     REVEAL ANIMATION
     ================================================================ */
  .reveal {
    opacity: 0;
    transform: translateY(60px);
    transition:
      opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal--visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ================================================================
     TABLET (≤ 1024px)
     ================================================================ */
  @media (max-width: 64rem) {
    .c-hero {
      height: clamp(420px, 55vw, 640px);
    }

    .c-hero__left {
      grid-column: 1 / -1;
    }

    .c-hero__watch {
      bottom: clamp(1.5rem, 4vw, 60px);
    }

    .c-body {
      padding: 48px 0;
    }

    .c-intro__left,
    .c-intro__desc {
      grid-column: 1 / -1;
    }

    .c-intro__desc {
      margin-top: 1.25rem;
      max-width: none;
      font-size: 20px;
      line-height: 28px;
    }

    .c-body__rows {
      margin-top: 56px;
    }

    .c-row + .c-row {
      margin-top: 56px;
    }

    .c-row__img-wrap {
      grid-column: 1 / -1;
      aspect-ratio: 924 / 520;
    }

    .c-row__text {
      grid-column: 1 / -1;
      padding-left: 0;
      padding-top: 28px;
    }

    .c-row--reverse .c-row__img-wrap {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .c-row--reverse .c-row__text {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-left: 0;
    }

    .c-row__title {
      font-size: 26px;
      line-height: 30px;
    }

    .c-row__desc {
      max-width: none;
    }

  }

  /* ================================================================
     MOBILE (≤ 768px)
     ================================================================ */
  @media (max-width: 48rem) {
    .c-hero {
      height: clamp(360px, 80vw, 500px);
    }

    .c-hero__img {
      width: 160%;
      left: -40%;
    }

    .c-hero__watch {
      bottom: clamp(1.5rem, 4vw, 60px);
      gap: 12px;
    }

    .c-hero__watch-icon {
      width: 40px;
      height: 40px;
    }

    .c-body {
      padding: 32px 0;
    }

    .c-intro__title {
      font-size: 24px;
      line-height: 28px;
    }

    .c-intro__desc {
      font-size: 18px;
      line-height: 24px;
    }

    .c-body__rows {
      margin-top: 40px;
    }

    .c-row + .c-row {
      margin-top: 40px;
    }

    .c-row__img-wrap {
      aspect-ratio: 924 / 480;
    }

    .c-row__text {
      padding-top: 20px;
    }

    .c-row__number {
      font-size: 12px;
    }

    .c-row__title {
      font-size: 22px;
      line-height: 26px;
    }

    .c-row__desc {
      margin-top: 16px;
      gap: 16px;
    }

    .c-row__desc p {
      font-size: 16px;
      line-height: 22px;
    }

    .c-row__capacity {
      margin-top: 24px;
    }
  }
</style>
