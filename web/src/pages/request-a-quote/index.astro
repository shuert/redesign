---
import Mainlayout from '../../layouts/Mainlayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import formImg from '../../assets/request-a-quote/60c26e97b304b786a121896cb8a9ba9c10e748e0.jpg';
---

<Mainlayout title="Request a Quote">
  <!-- Hero -->
  <section class="rq-hero">
    <div class="rq-hero__content container">
      <div class="page-grid rq-hero__grid">
        <div class="rq-hero__left">
          <p class="rq-hero__breadcrumb">
            <a href="/" class="rq-hero__breadcrumb--dim">HOME</a><span class="rq-hero__breadcrumb--dim" aria-hidden="true">&ensp;/&ensp;</span>REQUEST A QUOTE
          </p>
          <h1 class="rq-hero__title">request a quote</h1>
        </div>
        <div class="rq-hero__right">
          <p class="rq-hero__desc">
            Looking for a reusable packaging solution? Share a few details about your application and our team will review your requirements and prepare a customized quote tailored to your needs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <LeadForm
    variant="quote"
    image={formImg}
    imageAlt="Forklift operating among stacked Shuert reusable pallets in a warehouse"
    showMarket
    imageRatio="789 / 860"
  />
</Mainlayout>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .rq-hero {
    background: var(--c-black);
    padding-top: clamp(120px, 12.5vw, 216px);
    padding-bottom: clamp(1.5rem, 2.55vw, 44px);
  }

  .rq-hero__content {
    width: 100%;
  }

  .rq-hero__grid {
    align-items: end;
  }

  .rq-hero__left {
    grid-column: 1 / 8;
    padding-bottom: clamp(0.75rem, 1.56vw, 27px);
  }

  .rq-hero__breadcrumb {
    margin: 0 0 33px;
    font: var(--w-bold) 12px / 12px var(--ff-s);
    letter-spacing: 1.32px;
    text-transform: uppercase;
    color: var(--c-white);
  }

  .rq-hero__breadcrumb--dim {
    color: rgba(255, 255, 255, 0.35);
  }

  .rq-hero__breadcrumb a.rq-hero__breadcrumb--dim {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .rq-hero__breadcrumb a.rq-hero__breadcrumb--dim:hover,
  .rq-hero__breadcrumb a.rq-hero__breadcrumb--dim:focus-visible {
    color: rgba(255, 255, 255, 0.75);
  }

  .rq-hero__title {
    margin: 0;
    font: var(--w-semibold) clamp(2rem, 4.28vw, 4.625rem) / 0.81 var(--ff-s);
    color: var(--c-white);
    text-transform: lowercase;
  }

  .rq-hero__right {
    grid-column: 8 / -1;
    padding-left: clamp(0px, 3.59vw, 62px);
  }

  .rq-hero__desc {
    margin: 0;
    font: var(--w-light) 16px / 22px var(--ff-r);
    color: var(--c-white);
    max-width: 520px;
  }

  @media (min-width: 1728px) {
    .rq-hero__content {
      max-width: 1728px;
    }
  }

  @media (max-width: 64rem) {
    .rq-hero__left {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    .rq-hero__right {
      grid-column: 1 / -1;
      padding-left: 0;
      margin-top: 1.25rem;
    }

    .rq-hero__desc {
      max-width: none;
    }
  }

  @media (max-width: 48rem) {
    .rq-hero {
      padding-top: 110px;
    }
  }
</style>
